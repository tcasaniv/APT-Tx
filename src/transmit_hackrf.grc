- name: detect_platform
  id: epy_module
  parameters:
    alias: ''
    comment: ''
    source_code: "import platform\nfrom pathlib import Path\n\nAPP_FILES_DIR_NAME\
      \ = \"APT-Tx_Files\"\n\ndef get_app_files_dir():\n    \"\"\"Obtiene la ruta\
      \ a la carpeta de archivos de la aplicaci\xF3n y la crea si no existe.\"\"\"\
      \n    if platform.system() == \"Windows\":\n        base_path = Path(os.environ['USERPROFILE'])\
      \ / 'Documents'\n    else:\n        base_path = Path.home()\n    \n    app_dir\
      \ = base_path / APP_FILES_DIR_NAME\n    app_dir.mkdir(parents=True, exist_ok=True)\n\
      \    return str(app_dir)\n\noutput_filename = f\"apt_generated_audio.wav\"\n\
      generated_file_path = str(Path(get_app_files_dir()) / output_filename)\nwav_path\
      \ = generated_file_path\n\nprint(wav_path)"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 16.0]
    rotation: 0
    state: enabled
